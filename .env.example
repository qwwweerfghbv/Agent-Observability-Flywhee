# ===== LLM 配置 =====
# provider 可选：mock（零门槛体验，无需任何 API Key） / qwen / openai
LLM_PROVIDER=mock
QWEN_API_KEY=your_qwen_api_key_here
QWEN_MODEL=qwen-plus
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
# 兼容 OpenAI 协议的自定义服务端点（可选）
# OPENAI_BASE_URL=https://your-endpoint/v1

# ===== 数据库 =====
DATABASE_URL=sqlite+aiosqlite:///./data/job_agent.db

# ===== 应用 =====
APP_ENV=development
LOG_LEVEL=INFO
MAX_LLM_TURNS=20
LLM_TIMEOUT=30

# ===== 用户偏好（按需填写，留空则用代码默认值）=====
TARGET_CITY=
EXPECTED_SALARY_MIN=0
TARGET_POSITIONS=[]
